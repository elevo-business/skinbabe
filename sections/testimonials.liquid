<div class="section{% if section.settings.background == 'cream' %} surface-cream{% endif %}">
  <div class="page-width">
    <div class="section-head section-head--split reveal">
      <div class="stack" style="gap:.6rem">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">
            {{ section.settings.heading }}
            {%- if section.settings.heading_accent != blank -%}<span class="serif">{{ section.settings.heading_accent }}</span>{%- endif -%}
          </h2>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="link-arrow" href="{{ section.settings.link_url }}">
          {{ section.settings.link_label }}
          {% render 'icon', icon: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    <sb-slider class="reveal">
      <ul class="slider__track" data-slider-track style="--slide-width:82%;--slide-width-md:46%;--slide-width-lg:31%;">
        {%- for block in section.blocks -%}
          <li class="slider__item" {{ block.shopify_attributes }}>
            <div class="testimonial">
              {%- if block.settings.rating > 0 -%}
                <span class="rating__stars" aria-label="{{ block.settings.rating }} von 5 Sternen">
                  {%- for i in (1..5) -%}
                    {%- if i <= block.settings.rating -%}{% render 'icon', icon: 'star' %}{%- else -%}{% render 'icon', icon: 'star-outline' %}{%- endif -%}
                  {%- endfor -%}
                </span>
              {%- endif -%}

              {%- if block.settings.headline != blank -%}
                <p class="testimonial__quote" style="font-weight:600">{{ block.settings.headline }}</p>
              {%- endif -%}

              <p class="testimonial__quote">{{ block.settings.quote }}</p>

              <div class="testimonial__foot">
                {%- if block.settings.avatar != blank -%}
                  <span class="testimonial__avatar">
                    <img src="{{ block.settings.avatar | image_url: width: 120 }}" alt="" width="60" height="60" loading="lazy">
                  </span>
                {%- endif -%}
                <span>
                  <span class="testimonial__name">{{ block.settings.name }}</span>
                  {%- if block.settings.source != blank -%}
                    <span class="testimonial__source">
                      {%- if block.settings.source_url != blank -%}
                        <a href="{{ block.settings.source_url }}" target="_blank" rel="noopener" class="link-underline">{{ block.settings.source }}</a>
                      {%- else -%}
                        {{ block.settings.source }}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                  {%- if block.settings.verified -%}
                    <span class="testimonial__verified">{% render 'icon', icon: 'check' %} Verifizierter Kauf</span>
                  {%- endif -%}
                </span>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <div class="slider__nav" style="margin-top:1.5rem">
        <button class="slider__btn" type="button" data-slider-prev aria-label="{{ 'general.accessibility.previous_slide' | t }}">{% render 'icon', icon: 'arrow-left' %}</button>
        <button class="slider__btn" type="button" data-slider-next aria-label="{{ 'general.accessibility.next_slide' | t }}">{% render 'icon', icon: 'arrow' %}</button>
      </div>
    </sb-slider>

    {%- if section.settings.disclaimer != blank -%}
      <p class="small muted" style="margin-top:1.5rem">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Bewertungen",
  "max_blocks": 12,
  "settings": [
    { "type": "paragraph", "content": "Nur echte Bewertungen übernehmen — wörtlich, nicht schöner geschrieben. Keine erfundenen Namen, keine generierten Gesichter. Quelle und Link machen die Bewertung überprüfbar." },
    { "type": "text", "id": "eyebrow", "label": "Kleiner Vortext", "default": "bewertungen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "die meisten waren vorher skeptisch" },
    { "type": "text", "id": "heading_accent", "label": "Kursiver Serif-Akzent" },
    { "type": "text", "id": "link_label", "label": "Link-Text", "default": "alle bewertungen" },
    { "type": "url", "id": "link_url", "label": "Link-Ziel" },
    { "type": "textarea", "id": "disclaimer", "label": "Hinweis", "default": "Alle Bewertungen stammen von verifizierten Bestellungen und sind unverändert übernommen." },
    {
      "type": "select", "id": "background", "label": "Hintergrund", "default": "cream",
      "options": [{ "value": "default", "label": "Weiß" }, { "value": "cream", "label": "Creme" }]
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Bewertung",
      "settings": [
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "label": "Sterne", "default": 5 },
        { "type": "text", "id": "headline", "label": "Kurzfassung", "info": "Optional. Der erste Satz der Bewertung." },
        { "type": "textarea", "id": "quote", "label": "Bewertung", "default": "Ich hab ehrlich nicht damit gerechnet, dass es diesmal anders ist." },
        { "type": "text", "id": "name", "label": "Name", "info": "So, wie die Kundin ihn angegeben hat." },
        { "type": "image_picker", "id": "avatar", "label": "Bild", "info": "Nur mit Zustimmung. Keine Stockfotos als Kundinnen ausgeben." },
        { "type": "text", "id": "source", "label": "Quelle", "info": "z. B. Instagram-Handle oder Bewertungsplattform." },
        { "type": "url", "id": "source_url", "label": "Link zur Quelle" },
        { "type": "checkbox", "id": "verified", "label": "Verifizierter Kauf", "default": true }
      ]
    }
  ],
  "presets": [{ "name": "Bewertungen", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
