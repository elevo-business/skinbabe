{%- liquid
  assign groups = ''
  for block in section.blocks
    assign topic = block.settings.topic | default: ''
    if topic != '' and groups contains topic
    elsif topic != ''
      if groups == ''
        assign groups = topic
      else
        assign groups = groups | append: '|' | append: topic
      endif
    endif
  endfor
  assign group_list = groups | split: '|'
-%}
<div class="section{% if section.settings.background == 'cream' %} surface-cream{% endif %}">
  <div class="page-width{% if section.settings.width == 'narrow' %} page-width--narrow{% endif %}">
    <div class="section-head reveal{% if section.settings.text_align == 'center' %} section-head--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">
          {{ section.settings.heading }}
          {%- if section.settings.heading_accent != blank -%}<span class="serif">{{ section.settings.heading_accent }}</span>{%- endif -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte lede">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    {%- if group_list.size > 1 and section.settings.show_topics -%}
      <div class="faq-topics reveal" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        <button type="button" class="faq-topic" data-faq-topic="" aria-pressed="true">Alle</button>
        {%- for topic in group_list -%}
          <button type="button" class="faq-topic" data-faq-topic="{{ topic | escape }}" aria-pressed="false">{{ topic }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <sb-faq class="faq reveal" data-single="{{ section.settings.single_open }}">
      {%- for block in section.blocks -%}
        <details
          class="faq__item"
          data-topic="{{ block.settings.topic | escape }}"
          {% if section.settings.open_first and forloop.first %}open{% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="faq__q">
            <span>{{ block.settings.question }}</span>
            {% render 'icon', icon: 'chevron' %}
          </summary>
          <div class="faq__a">
            <div class="rte">{{ block.settings.answer }}</div>
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="link-arrow" href="{{ block.settings.link }}">
                {{ block.settings.link_label }}
                {% render 'icon', icon: 'arrow' %}
              </a>
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </sb-faq>

    {%- if section.settings.footer_text != blank -%}
      <div class="faq-foot reveal">
        <p>{{ section.settings.footer_text }}</p>
        {%- if section.settings.footer_link != blank -%}
          <a class="btn btn--secondary btn--sm" href="{{ section.settings.footer_link }}">
            {{ section.settings.footer_link_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.structured_data -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 12,
  "settings": [
    { "type": "paragraph", "content": "Die Fragen, die sie wirklich vor dem Kauf stellt — nicht die, die sich gut lesen. Jede Antwort darf auf die Seite verlinken, die den Einwand vollständig auflöst." },
    { "type": "text", "id": "eyebrow", "label": "Kleiner Vortext", "default": "was du wissen willst" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "die fragen, die du vor dem kauf stellst" },
    { "type": "text", "id": "heading_accent", "label": "Kursiver Serif-Akzent" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "open_first", "label": "Erste Frage geöffnet zeigen", "default": true, "info": "Macht sichtbar, dass sich die Zeilen aufklappen lassen." },
    { "type": "checkbox", "id": "single_open", "label": "Nur eine Frage gleichzeitig geöffnet", "default": true },
    { "type": "checkbox", "id": "show_topics", "label": "Themenfilter anzeigen", "default": true, "info": "Erscheint nur, wenn mindestens zwei Themen vergeben sind." },
    { "type": "checkbox", "id": "structured_data", "label": "FAQ-Markup für Google ausgeben", "default": true },
    { "type": "text", "id": "footer_text", "label": "Abschlusstext", "default": "Deine Frage ist nicht dabei?" },
    { "type": "text", "id": "footer_link_label", "label": "Button", "default": "Schreib uns" },
    { "type": "url", "id": "footer_link", "label": "Button-Ziel" },
    {
      "type": "select", "id": "width", "label": "Breite", "default": "narrow",
      "options": [{ "value": "narrow", "label": "Schmal" }, { "value": "wide", "label": "Breit" }]
    },
    {
      "type": "select", "id": "text_align", "label": "Ausrichtung", "default": "left",
      "options": [{ "value": "left", "label": "Links" }, { "value": "center", "label": "Zentriert" }]
    },
    {
      "type": "select", "id": "background", "label": "Hintergrund", "default": "default",
      "options": [{ "value": "default", "label": "Weiß" }, { "value": "cream", "label": "Creme" }]
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "Warum 50 Euro für einen Rasierer?" },
        { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Weil der Vergleichsrahmen nicht der Einwegrasierer ist.</p>" },
        { "type": "text", "id": "topic", "label": "Thema", "info": "z. B. Anwendung, Versand, Garantie. Gleiche Schreibweise verwenden." },
        { "type": "text", "id": "link_label", "label": "Weiterführender Link" },
        { "type": "url", "id": "link", "label": "Link-Ziel" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq", "settings": { "topic": "Preis", "question": "Warum 50 Euro für einen Rasierer?", "answer": "<p>Weil der Vergleichsrahmen nicht der Einwegrasierer ist. Rechne gegen zweimal Waxing im Studio oder gegen ein Jahr Ersatzklingen — dann ist die Frage eine andere.</p>" } },
        { "type": "faq", "settings": { "topic": "Wirkung", "question": "Bei mir funktioniert sowas eh nicht. Warum jetzt?", "answer": "<p>Weil du bisher immer dieselbe Art von Werkzeug getestet hast. Ein Schutzkopf hat keinen direkten Klingenkontakt zur Haut — das ist ein anderer Mechanismus. Und wenn es bei dir trotzdem nicht klappt, zahlen wir zurück.</p>" } },
        { "type": "faq", "settings": { "topic": "Auswahl", "question": "Tut das an empfindlichen Stellen weh?", "answer": "<p>Der Schutzkopf hält die Klinge auf Abstand — genau dafür ist er gemacht. Kein Ziepen, kein direkter Schnitt auf der Haut.</p>" } },
        { "type": "faq", "settings": { "topic": "Anwendung", "question": "Wie oft brauche ich Ersatzköpfe?", "answer": "<p>Je nach Nutzung alle drei bis sechs Monate. Du bekommst eine Erinnerung, wenn es soweit ist — ohne Abo-Zwang.</p>" } },
        { "type": "faq", "settings": { "topic": "Versand", "question": "Wie lange dauert die Lieferung?", "answer": "<p>Zwei bis vier Werktage innerhalb Deutschlands. Bestellungen bis 14 Uhr gehen am selben Werktag raus.</p>" } },
        { "type": "faq", "settings": { "topic": "Garantie", "question": "Was, wenn ich es zurückgeben will?", "answer": "<p>Du schreibst uns, bekommst ein Etikett und dein Geld zurück — auch wenn das Gerät geöffnet und benutzt ist.</p>" } }
      ]
    }
  ]
}
{% endschema %}
