{%- liquid
  assign limit = section.settings.limit
-%}
{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <div class="section{% if section.settings.background == 'cream' %} surface-cream{% endif %}">
    <div class="page-width">
      <div class="section-head reveal">
        <h2 class="h3">{{ section.settings.heading }}</h2>
      </div>
      <div class="product-grid" style="--cols:4;--cols-tablet:3;">
        {%- for product in recommendations.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- elsif recommendations.performed == false -%}
  <div
    class="section"
    data-recommendations
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}"
  >
    <script>
      (function () {
        var el = document.currentScript.closest('[data-recommendations]');
        fetch(el.dataset.url)
          .then(function (r) { return r.text(); })
          .then(function (html) {
            var section = new DOMParser().parseFromString(html, 'text/html').querySelector('.shopify-section');
            if (section) { el.closest('.shopify-section').innerHTML = section.innerHTML; }
            if (window.SkinbabeTheme) window.SkinbabeTheme.initReveal();
          })
          .catch(function () {});
      })();
    </script>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Passt dazu",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "passt dazu" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Anzahl Produkte", "default": 4 },
    {
      "type": "select", "id": "background", "label": "Hintergrund", "default": "default",
      "options": [{ "value": "default", "label": "Weiß" }, { "value": "cream", "label": "Creme" }]
    }
  ],
  "presets": [{ "name": "Passt dazu" }]
}
{% endschema %}
