{%- comment -%} Risk-Reversal / Wiederhol-CTA mit optionalen Garantie-Siegeln {%- endcomment -%}
<div class="section{% if section.settings.background == 'cream' %} surface-cream{% elsif section.settings.background == 'ink' %} surface-ink{% endif %}">
  <div class="page-width page-width--narrow">
    <div class="cta-banner reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}{%- if section.settings.heading_accent != blank -%} <span class="serif">{{ section.settings.heading_accent }}</span>{%- endif -%}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte lede">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--lg" href="{{ section.settings.button_link | default: product.url | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label }}{% render 'icon', icon: 'arrow' %}
        </a>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="cta-seals">
          {%- for block in section.blocks -%}
            <li class="cta-seal" {{ block.shopify_attributes }}>
              {% render 'icon', icon: block.settings.icon %}
              <span><strong>{{ block.settings.title }}</strong>{% if block.settings.text != blank %}<span class="cta-seal__sub">{{ block.settings.text }}</span>{% endif %}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CTA-Banner",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleiner Vortext", "default": "ohne risiko" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Teste es risikofrei" },
    { "type": "text", "id": "heading_accent", "label": "Kursiver Serif-Akzent" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Wenn es bei dir nicht funktioniert, bekommst du dein Geld zurück. Ganz einfach.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "In den Warenkorb" },
    { "type": "url", "id": "button_link", "label": "Button-Link", "info": "Leer lassen, um auf das aktuelle Produkt zu verlinken." },
    { "type": "select", "id": "background", "label": "Hintergrund", "default": "cream", "options": [
      { "value": "default", "label": "Weiß" }, { "value": "cream", "label": "Creme" }, { "value": "ink", "label": "Dunkel" }] }
  ],
  "blocks": [
    { "type": "seal", "name": "Siegel", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [
        { "value": "shield", "label": "shield" }, { "value": "return", "label": "return" }, { "value": "clock", "label": "clock" }, { "value": "chat", "label": "chat" }, { "value": "truck", "label": "truck" }, { "value": "check", "label": "check" }] },
      { "type": "text", "id": "title", "label": "Titel", "default": "30 Tage Garantie" },
      { "type": "text", "id": "text", "label": "Zusatz", "default": "Geld zurück" } ] }
  ],
  "presets": [ { "name": "CTA-Banner", "blocks": [ { "type": "seal" }, { "type": "seal", "settings": { "icon": "return", "title": "Kostenlose Rücksendung", "text": "innerhalb der Frist" } }, { "type": "seal", "settings": { "icon": "chat", "title": "Support auf Deutsch", "text": "werktags in 24 h" } } ] } ]
}
{% endschema %}
