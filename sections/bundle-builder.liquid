{%- comment -%}
  Set-Konfigurator. Pro Schritt eine Auswahl aus einer Kategorie,
  Live-Summe rechts, ein Klick legt alle Positionen gemeinsam in den Korb.
{%- endcomment -%}
<div class="section{% if section.settings.background == 'cream' %} surface-cream{% endif %}">
  <div class="page-width">
    <div class="section-head reveal{% if section.settings.text_align == 'center' %} section-head--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">
          {{ section.settings.heading }}
          {%- if section.settings.heading_accent != blank -%}<span class="serif">{{ section.settings.heading_accent }}</span>{%- endif -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte lede">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <sb-builder class="builder reveal">
      <div class="builder__steps">
        {%- for block in section.blocks -%}
          {%- liquid
            assign step_collection = collections[block.settings.collection]
            assign step_limit = block.settings.limit | default: 6
          -%}
          <div
            data-builder-step
            data-step-title="{{ block.settings.title | escape }}"
            data-required="{{ block.settings.required }}"
            {{ block.shopify_attributes }}
          >
            <div class="builder__step-head">
              <span class="builder__step-num">{{ forloop.index }}</span>
              <h3 class="builder__step-title">{{ block.settings.title }}</h3>
              {%- unless block.settings.required -%}
                <span class="builder__step-optional">optional</span>
              {%- endunless -%}
            </div>

            {%- if block.settings.description != blank -%}
              <p class="builder__hint" style="margin:-.5rem 0 1rem">{{ block.settings.description }}</p>
            {%- endif -%}

            <div class="builder__cards">
              {%- if block.settings.required == false -%}
                <label class="builder__card" data-builder-card>
                  <input type="radio" name="builder-{{ block.id }}" checked>
                  <span class="media media--square" style="display:grid;place-items:center;background:var(--sb-cream)">
                    <span class="muted small" style="position:relative;z-index:1">ohne</span>
                  </span>
                  <span class="builder__card-title">Nicht dazunehmen</span>
                  <span class="builder__card-price">0,00 €</span>
                </label>
              {%- endif -%}

              {%- for product in step_collection.products limit: step_limit -%}
                {%- liquid
                  assign pv = product.selected_or_first_available_variant
                  assign is_first = false
                  if forloop.first and block.settings.required
                    assign is_first = true
                  endif
                -%}
                <label class="builder__card{% if is_first %} is-selected{% endif %}" data-builder-card>
                  <input
                    type="radio"
                    name="builder-{{ block.id }}"
                    data-variant-id="{{ pv.id }}"
                    data-price="{{ pv.price }}"
                    data-quantity="{{ block.settings.quantity | default: 1 }}"
                    data-title="{{ product.title | escape }}"
                    {% if is_first %}checked{% endif %}
                    {% unless product.available %}disabled{% endunless %}
                  >
                  <span class="builder__card-check">{% render 'icon', icon: 'check' %}</span>
                  <span class="media media--square">
                    {%- if product.featured_media -%}
                      <img src="{{ product.featured_media | image_url: width: 400 }}" alt="{{ product.featured_media.alt | escape }}" width="200" height="200" loading="lazy">
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </span>
                  <span class="builder__card-title">{{ product.title }}</span>
                  <span class="builder__card-price">
                    {%- if product.available -%}{{ pv.price | money }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                  </span>
                </label>
              {%- else -%}
                <p class="muted small">Wähle im Customizer eine Kategorie für diesen Schritt.</p>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <aside class="builder__summary">
        <span class="builder__summary-title">{{ section.settings.summary_title }}</span>
        <ul class="builder__list" data-builder-summary></ul>

        <div class="builder__total">
          <span>{{ 'cart.general.total' | t }}</span>
          <span class="builder__total-value" data-builder-total>0,00 €</span>
        </div>

        <button type="button" class="btn btn--full btn--lg" data-builder-add>
          <span data-btn-label>{{ section.settings.button_label }}</span>
        </button>

        <p class="form__message form__message--error" data-builder-error hidden></p>

        {%- if section.settings.hint != blank -%}
          <p class="builder__hint">{{ section.settings.hint }}</p>
        {%- endif -%}
      </aside>
    </sb-builder>
  </div>
</div>

{% schema %}
{
  "name": "Set-Konfigurator",
  "max_blocks": 5,
  "settings": [
    { "type": "paragraph", "content": "Jeder Block ist ein Schritt. Die Auswahl je Schritt kommt aus einer Kategorie — so bleibt der Konfigurator ohne Code erweiterbar." },
    { "type": "text", "id": "eyebrow", "label": "Kleiner Vortext", "default": "set zusammenstellen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "bau dir das set, das zu dir passt" },
    { "type": "text", "id": "heading_accent", "label": "Kursiver Serif-Akzent" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Drei Schritte, eine Bestellung. Was du nicht brauchst, lässt du weg.</p>" },
    { "type": "text", "id": "summary_title", "label": "Überschrift der Zusammenfassung", "default": "Dein Set" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Set in den Warenkorb" },
    { "type": "textarea", "id": "hint", "label": "Hinweis unter dem Button", "default": "Versandkostenfrei ab 50 €. 30 Tage Rückgabe auf jede Position." },
    {
      "type": "select", "id": "text_align", "label": "Ausrichtung", "default": "left",
      "options": [{ "value": "left", "label": "Links" }, { "value": "center", "label": "Zentriert" }]
    },
    {
      "type": "select", "id": "background", "label": "Hintergrund", "default": "default",
      "options": [{ "value": "default", "label": "Weiß" }, { "value": "cream", "label": "Creme" }]
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Wähle dein Gerät" },
        { "type": "text", "id": "description", "label": "Beschreibung" },
        { "type": "collection", "id": "collection", "label": "Kategorie mit den Optionen" },
        { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Maximale Anzahl Optionen", "default": 6 },
        { "type": "range", "id": "quantity", "min": 1, "max": 6, "step": 1, "label": "Menge pro Auswahl", "default": 1 },
        { "type": "checkbox", "id": "required", "label": "Pflichtschritt", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Set-Konfigurator",
      "blocks": [
        { "type": "step", "settings": { "title": "Wähle dein Gerät", "required": true } },
        { "type": "step", "settings": { "title": "Ersatzköpfe dazu", "required": false } },
        { "type": "step", "settings": { "title": "Pflege dazu", "required": false } }
      ]
    }
  ]
}
{% endschema %}
