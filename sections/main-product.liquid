{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign bundle_rendered = false
-%}
<div class="section">
  <div class="page-width">
    <div class="product">
      {% render 'product-gallery', product: product, section: section, layout: section.settings.gallery_layout %}

      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'vendor' -%}
              <p class="eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</p>

            {%- when 'title' -%}
              <div {{ block.shopify_attributes }}>
                <h1 class="h2 product__title">{{ product.title }}</h1>
                {%- if block.settings.subtitle != blank -%}
                  <p class="lede" style="margin-top:.5rem">{{ block.settings.subtitle }}</p>
                {%- elsif product.metafields.skinbabe.card_subtitle.value != blank -%}
                  <p class="lede" style="margin-top:.5rem">{{ product.metafields.skinbabe.card_subtitle.value }}</p>
                {%- endif -%}
              </div>

            {%- when 'rating' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'rating', product: product, style: block.settings.style %}
              </div>

            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }}>
                {%- assign price_id = 'price-' | append: section.id -%}
                {% render 'price', product: product, id: price_id %}
                {%- if block.settings.tax_note != blank -%}
                  <p class="small muted" style="margin-top:.35rem">{{ block.settings.tax_note }}</p>
                {%- endif -%}
              </div>

            {%- when 'arguments' -%}
              <ul class="product__args" {{ block.shopify_attributes }}>
                {%- for i in (1..4) -%}
                  {%- assign key = 'arg_' | append: i -%}
                  {%- assign arg = block.settings[key] -%}
                  {%- if arg != blank -%}
                    <li class="product__arg">
                      {% render 'icon', icon: 'check' %}
                      <span>{{ arg }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'notice' -%}
              {%- if block.settings.text != blank -%}
                <div class="product__notice" {{ block.shopify_attributes }}>
                  {% render 'icon', icon: block.settings.icon %}
                  <div>
                    <div class="rte">{{ block.settings.text }}</div>
                    {%- if block.settings.link_label != blank -%}
                      <a href="{{ block.settings.link }}" style="display:inline-block;margin-top:.35rem">{{ block.settings.link_label }}</a>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}

            {%- when 'variants' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'variant-picker', product: product, section: section %}
              </div>

            {%- when 'bundle_option' -%}
              {%- unless bundle_rendered -%}
                {%- assign bundle_rendered = true -%}
                <div {{ block.shopify_attributes }}>
                  {% render 'bundle-options', product: product, section: section %}
                </div>
              {%- endunless -%}

            {%- when 'plan' -%}
              {%- if product.selling_plan_groups.size > 0 -%}
                <div {{ block.shopify_attributes }}>
                  {% render 'selling-plans', product: product, section: section, block: block %}
                </div>
              {%- endif -%}

            {%- when 'usp' -%}
              <div class="usp-row usp-row--inline{% if block.settings.compact %} usp-row--compact{% endif %}" style="--usp-cols:{{ block.settings.columns }};" {{ block.shopify_attributes }}>
                {%- for i in (1..4) -%}
                  {%- liquid
                    assign title_key = 'title_' | append: i
                    assign text_key = 'text_' | append: i
                    assign icon_key = 'icon_' | append: i
                    assign usp_title = block.settings[title_key]
                  -%}
                  {%- if usp_title != blank -%}
                    <div class="usp">
                      {% render 'icon', icon: block.settings[icon_key] %}
                      <div>
                        <span class="usp__title">{{ usp_title }}</span>
                        {%- if block.settings[text_key] != blank -%}
                          <span class="usp__text">{{ block.settings[text_key] }}</span>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'specs' -%}
              <table class="specs" {{ block.shopify_attributes }}>
                <tbody>
                  {%- for i in (1..6) -%}
                    {%- liquid
                      assign label_key = 'label_' | append: i
                      assign value_key = 'value_' | append: i
                      assign spec_label = block.settings[label_key]
                    -%}
                    {%- if spec_label != blank -%}
                      <tr>
                        <th scope="row">{{ spec_label }}</th>
                        <td>{{ block.settings[value_key] }}</td>
                      </tr>
                    {%- endif -%}
                  {%- endfor -%}
                </tbody>
              </table>

            {%- when 'payment' -%}
              {%- if shop.enabled_payment_types.size > 0 -%}
                <div class="payment-row" {{ block.shopify_attributes }}>
                  <span class="visually-hidden">{{ 'sections.footer.payment_methods' | t }}</span>
                  {%- for type in shop.enabled_payment_types limit: block.settings.limit -%}
                    {{ type | payment_type_svg_tag: class: 'payment-icon' }}
                  {%- endfor -%}
                </div>
              {%- endif -%}

            {%- when 'buy' -%}
              <div id="buy-anchor-{{ section.id }}" {{ block.shopify_attributes }}>
                {% render 'buy-buttons', product: product, section: section, show_quantity: block.settings.show_quantity, show_dynamic_checkout: block.settings.show_dynamic_checkout %}
                {%- if block.settings.payment_note != blank -%}
                  <p class="small muted center" style="margin-top:.65rem">{{ block.settings.payment_note }}</p>
                {%- endif -%}
              </div>

            {%- when 'trust' -%}
              <div class="trust-grid" {{ block.shopify_attributes }}>
                {%- for i in (1..4) -%}
                  {%- liquid
                    assign text_key = 'text_' | append: i
                    assign icon_key = 'icon_' | append: i
                    assign text = block.settings[text_key]
                  -%}
                  {%- if text != blank -%}
                    <div class="trust-grid__item">
                      {% render 'icon', icon: block.settings[icon_key] %}
                      <span>{{ text }}</span>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'inventory' -%}
              {%- if variant.available and variant.inventory_management != blank and variant.inventory_quantity > 0 and variant.inventory_quantity <= block.settings.threshold -%}
                <p class="small" style="color:var(--sb-accent)" {{ block.shopify_attributes }}>
                  {{ 'products.product.low_stock' | t }}
                </p>
              {%- endif -%}

            {%- when 'accordion' -%}
              <div class="product-accordion" {{ block.shopify_attributes }}>
                {%- for i in (1..4) -%}
                  {%- liquid
                    assign title_key = 'title_' | append: i
                    assign content_key = 'content_' | append: i
                    assign title = block.settings[title_key]
                    assign content = block.settings[content_key]
                  -%}
                  {%- if title != blank -%}
                    <details>
                      <summary>{{ title }} {% render 'icon', icon: 'chevron' %}</summary>
                      <div class="rte">
                        {%- if content != blank -%}{{ content }}{%- elsif i == 1 -%}{{ product.description }}{%- endif -%}
                      </div>
                    </details>
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'text' -%}
              <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'signal' -%}
              <div {{ block.shopify_attributes }}>{% render 'product-signal', product: product, block: block %}</div>

            {%- when 'cutoff' -%}
              <div {{ block.shopify_attributes }}>{% render 'product-cutoff', block: block %}</div>

            {%- when '@app' -%}
              {% render block %}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- if section.settings.enable_sticky_bar -%}
  {% render 'sticky-buy-bar', product: product, section: section %}
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    "url": {{ shop.url | append: product.url | json }},
    {%- if product.featured_media -%}
    "image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif -%}
    {%- if product.vendor != blank -%}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    {%- endif -%}
    {%- comment -%}
      AggregateRating nur, wenn echte Bewertungen aus einer Review-App
      vorliegen. Ausgedachte Werte hier waeren gegenueber Google eine
      Falschangabe und fliegen frueher oder spaeter auf.
    {%- endcomment -%}
    {%- assign review_rating = product.metafields.reviews.rating.value -%}
    {%- assign review_count = product.metafields.reviews.rating_count.value | plus: 0 -%}
    {%- if review_rating and review_count > 0 -%}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ review_rating.rating | json }},
      "bestRating": {{ review_rating.scale_max | json }},
      "worstRating": {{ review_rating.scale_min | default: 1 | json }},
      "ratingCount": {{ review_count | json }}
    },
    {%- endif -%}
    "offers": [
      {%- for v in product.variants -%}
        {
          "@type": "Offer",
          "sku": {{ v.sku | json }},
          "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ v.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ shop.url | append: product.url | append: '?variant=' | append: v.id | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

