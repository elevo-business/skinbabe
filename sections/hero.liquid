{%- liquid
  assign layout = section.settings.layout
  assign stats = section.blocks | where: 'type', 'stat'
  assign has_media = false
  if section.settings.image != blank or section.settings.image_mobile != blank or section.settings.video != blank
    assign has_media = true
  endif
-%}
<div
  class="
    hero hero--{{ layout }} hero--align-{{ section.settings.content_position }}
    {%- if section.settings.media_position == 'left' %} hero--media-left{% endif -%}
    {%- if section.settings.full_bleed == false %} hero--contained{% endif -%}
  "
  style="
    --hero-min-height:{{ section.settings.height }}vh;
    --hero-min-height-mobile:{{ section.settings.height_mobile }}vh;
    --hero-focal:{{ section.settings.focal_x }}% {{ section.settings.focal_y }}%;
    --hero-overlay:{{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-align:{{ section.settings.content_position | replace: 'top', 'start' | replace: 'middle', 'center' | replace: 'bottom', 'end' }};
    --hero-inset:{{ section.settings.content_inset }}px;
    --hero-inset-mobile:{{ section.settings.content_inset_mobile }}px;
    --hero-inset-top:{{ section.settings.content_inset }}px;
    --hero-inset-top-mobile:{{ section.settings.content_inset_mobile }}px;
  "
>
  {%- if layout == 'overlay' -%}
    <div class="hero__media">
      {% render 'hero-media', section: section, has_media: has_media %}
    </div>
    <div class="page-width hero__inner">
      <div class="hero__content{% if section.settings.text_align == 'center' %} hero__content--center{% endif %} reveal">
        {% render 'hero-text', section: section %}
      </div>
    </div>
  {%- else -%}
    <div class="hero__content{% if section.settings.text_align == 'center' %} hero__content--center{% endif %} reveal">
      {% render 'hero-text', section: section %}
    </div>
    <div class="hero__media">
      {% render 'hero-media', section: section, has_media: has_media %}
    </div>
  {%- endif -%}
</div>

{%- if stats.size > 0 -%}
  <div class="page-width">
    <div class="hero-stats">
      {%- for block in stats -%}
        <div class="hero-stats__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}{% render 'icon', icon: block.settings.icon %}{%- endif -%}
          <span class="hero-stats__value">{{ block.settings.value }}</span>
          <span class="hero-stats__label">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "class": "shopify-section--hero",
  "max_blocks": 3,
  "settings": [
    {
      "type": "paragraph",
      "content": "Die Headline zielt auf das Gefühl, nicht auf das Produkt. Ein Gedanke, kein Feature-Stapel."
    },
    {
      "type": "header",
      "content": "Hero-Bild"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero-Bild (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Hero-Bild (Mobil)",
      "info": "Optional. Ohne eigenes Mobil-Bild wird das Desktop-Bild verwendet."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video statt Bild",
      "info": "Läuft stumm und in Schleife. Hat Vorrang vor dem Bild."
    },
    {
      "type": "range",
      "id": "focal_x",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Bildausschnitt horizontal",
      "default": 50
    },
    {
      "type": "range",
      "id": "focal_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Bildausschnitt vertikal",
      "default": 50
    },
    {
      "type": "header",
      "content": "Format"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "split",
      "options": [
        {
          "value": "split",
          "label": "Zweispaltig (Text neben Bild)"
        },
        {
          "value": "overlay",
          "label": "Vollflächiges Bild mit Text darauf"
        }
      ]
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Bildposition (zweispaltig)",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ]
    },
    {
      "type": "range",
      "id": "height",
      "min": 45,
      "max": 92,
      "step": 1,
      "unit": "vh",
      "label": "Höhe (Desktop)",
      "default": 78
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 40,
      "max": 90,
      "step": 1,
      "unit": "vh",
      "label": "Höhe (Mobil)",
      "default": 62
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Randlos über die volle Breite",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Abdunklung (nur vollflächig)",
      "default": 35
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Textausrichtung",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Zentriert"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Textposition (vollflächig)",
      "default": "bottom",
      "options": [
        {
          "value": "top",
          "label": "Oben"
        },
        {
          "value": "middle",
          "label": "Mittig"
        },
        {
          "value": "bottom",
          "label": "Unten"
        }
      ],
      "info": "Bei „Oben“ rückt der Text automatisch unter den überlagernden Header."
    },
    {
      "type": "range",
      "id": "content_inset",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Abstand zum Rand (Desktop)",
      "default": 48,
      "info": "Kleinerer Wert schiebt den Text weiter nach unten beziehungsweise oben."
    },
    {
      "type": "range",
      "id": "content_inset_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand zum Rand (Mobil)",
      "default": 32
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleiner Vortext"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "hör auf zu rechnen, wann du dich zuletzt rasiert hast"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Kursiver Serif-Akzent",
      "info": "Wird an die Headline angehängt und kursiv gesetzt."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Du hast Jahre lang gedacht, es liegt an deiner Haut. Tut es nicht. Es liegt an dem Ding in deiner Hand.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "rasierer ansehen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button-Link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Zweiter Button",
      "default": "warum haare einwachsen"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Zweiter Button-Link"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Kennzahl",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Wert",
          "default": "30 Tage"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Bezeichnung",
          "default": "Rückgabe"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "return",
          "options": [
            {
              "value": "none",
              "label": "Kein Icon"
            },
            {
              "value": "return",
              "label": "Rückgabe"
            },
            {
              "value": "truck",
              "label": "Versand"
            },
            {
              "value": "clock",
              "label": "Lieferzeit"
            },
            {
              "value": "card",
              "label": "Zahlung"
            },
            {
              "value": "shield",
              "label": "Garantie"
            },
            {
              "value": "chat",
              "label": "Support"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "30 Tage",
            "label": "Rückgabe",
            "icon": "return"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "2–4 Werktage",
            "label": "Lieferzeit",
            "icon": "truck"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "Klarna & PayPal",
            "label": "Zahlung",
            "icon": "card"
          }
        }
      ]
    }
  ]
}
{% endschema %}
