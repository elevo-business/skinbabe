<div class="section{% if section.settings.background == 'cream' %} surface-cream{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-head reveal{% if section.settings.text_align == 'center' %} section-head--center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">
            {{ section.settings.heading }}
            {%- if section.settings.heading_accent != blank -%}<span class="serif">{{ section.settings.heading_accent }}</span>{%- endif -%}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- assign is_reversed = forloop.index0 | modulo: 2 -%}
      <div class="feature-row{% if is_reversed == 1 %} feature-row--reverse{% endif %} reveal" {{ block.shopify_attributes }}>
        <div class="feature-row__content">
          {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
          <h3 class="h3">
            {{ block.settings.title }}
            {%- if block.settings.title_accent != blank -%}<span class="serif">{{ block.settings.title_accent }}</span>{%- endif -%}
          </h3>
          {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.punchline != blank -%}<p class="punchline">{{ block.settings.punchline }}</p>{%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a class="link-arrow" href="{{ block.settings.button_link }}">
              {{ block.settings.button_label }}
              {% render 'icon', icon: 'arrow' %}
            </a>
          {%- endif -%}
        </div>

        <div class="feature-row__media">
          <div class="media media--{{ block.settings.image_ratio }}">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1200 }}"
                srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                sizes="(min-width: 990px) 50vw, 100vw"
                alt="{{ block.settings.image.alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Feature-Reihen",
  "max_blocks": 6,
  "settings": [
    { "type": "paragraph", "content": "Ein Gedanke pro Reihe. Kein Feature ohne Konsequenz — der letzte Satz ist die Pointe." },
    { "type": "text", "id": "eyebrow", "label": "Kleiner Vortext" },
    { "type": "text", "id": "heading", "label": "Überschrift" },
    { "type": "text", "id": "heading_accent", "label": "Kursiver Serif-Akzent" },
    {
      "type": "select", "id": "text_align", "label": "Ausrichtung der Überschrift", "default": "left",
      "options": [{ "value": "left", "label": "Links" }, { "value": "center", "label": "Zentriert" }]
    },
    {
      "type": "select", "id": "background", "label": "Hintergrund", "default": "default",
      "options": [{ "value": "default", "label": "Weiß" }, { "value": "cream", "label": "Creme" }]
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Reihe",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        {
          "type": "select", "id": "image_ratio", "label": "Bildformat", "default": "portrait",
          "options": [{ "value": "square", "label": "1:1" }, { "value": "portrait", "label": "4:5" }, { "value": "landscape", "label": "3:2" }]
        },
        { "type": "text", "id": "eyebrow", "label": "Kleiner Vortext" },
        { "type": "text", "id": "title", "label": "Überschrift", "default": "der schutzkopf" },
        { "type": "text", "id": "title_accent", "label": "Kursiver Serif-Akzent" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Ein feines Gitter zwischen Klinge und Haut. Das Haar wird auf Hautniveau gekürzt statt darunter.</p>" },
        { "type": "text", "id": "punchline", "label": "Pointe" },
        { "type": "text", "id": "button_label", "label": "Link-Text" },
        { "type": "url", "id": "button_link", "label": "Link-Ziel" }
      ]
    }
  ],
  "presets": [{ "name": "Feature-Reihen", "blocks": [{ "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
