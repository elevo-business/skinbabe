<div class="section{% if section.settings.background == 'cream' %} surface-cream{% elsif section.settings.background == 'ink' %} surface-ink{% endif %}">
  <div class="page-width">
    <div class="newsletter reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">
          {{ section.settings.heading }}
          {%- if section.settings.heading_accent != blank -%}<span class="serif">{{ section.settings.heading_accent }}</span>{%- endif -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte lede">{{ section.settings.text }}</div>{%- endif -%}

      {% form 'customer', class: 'form-inline' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'general.newsletter_form.email_placeholder' | t }}</label>
        <input
          id="NewsletterEmail-{{ section.id }}"
          class="input"
          type="email"
          name="contact[email]"
          placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
          autocomplete="email"
          required
        >
        <button type="submit" class="btn">{{ section.settings.button_label | default: 'Anmelden' }}</button>

        {%- if form.errors -%}
          <p class="form__message form__message--error">{{ form.errors.messages.form }}</p>
        {%- elsif form.posted_successfully? -%}
          <p class="form__message form__message--success">{% render 'icon', icon: 'check' %} {{ 'general.newsletter_form.success' | t }}</p>
        {%- endif -%}
      {% endform %}

      {%- if section.settings.legal != blank -%}
        <p class="newsletter__legal">{{ section.settings.legal }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleiner Vortext" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "wir schreiben selten. dafür nichts überflüssiges." },
    { "type": "text", "id": "heading_accent", "label": "Kursiver Serif-Akzent" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Neue Produkte, Nachkauf-Erinnerungen und gelegentlich etwas, das dir wirklich hilft.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Anmelden" },
    { "type": "textarea", "id": "legal", "label": "Rechtlicher Hinweis", "default": "Mit der Anmeldung stimmst du dem Erhalt von E-Mails zu. Abmeldung jederzeit über den Link in jeder Mail. Details in unserer Datenschutzerklärung." },
    {
      "type": "select", "id": "background", "label": "Hintergrund", "default": "cream",
      "options": [
        { "value": "default", "label": "Weiß" },
        { "value": "cream", "label": "Creme" },
        { "value": "ink", "label": "Dunkel" }
      ]
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
