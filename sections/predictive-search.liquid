{%- comment -%} Wird per fetch von <sb-predictive-search> geladen. {%- endcomment -%}
<div data-predictive-content>
  {%- if predictive_search.performed -%}
    {%- if predictive_search.resources.products.size > 0 -%}
      <p class="eyebrow">Produkte</p>
      {%- for product in predictive_search.resources.products -%}
        <a class="search-result" href="{{ product.url }}">
          <span class="search-result__media">
            {%- if product.featured_media -%}
              <img src="{{ product.featured_media | image_url: width: 160 }}" alt="" width="80" height="80" loading="lazy">
            {%- endif -%}
          </span>
          <span>
            <span class="search-result__title">{{ product.title }}</span>
            {% render 'price', product: product %}
          </span>
        </a>
      {%- endfor -%}
    {%- endif -%}

    {%- if predictive_search.resources.pages.size > 0 or predictive_search.resources.articles.size > 0 -%}
      <p class="eyebrow" style="margin-top:1.25rem">Seiten</p>
      <div class="stack" style="gap:.5rem">
        {%- for page in predictive_search.resources.pages -%}
          <a href="{{ page.url }}" class="link-underline small">{{ page.title }}</a>
        {%- endfor -%}
        {%- for article in predictive_search.resources.articles -%}
          <a href="{{ article.url }}" class="link-underline small">{{ article.title }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.products.size == 0 and predictive_search.resources.pages.size == 0 and predictive_search.resources.articles.size == 0 -%}
      <p class="small muted">{{ 'general.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Suchvorschläge" }
{% endschema %}
