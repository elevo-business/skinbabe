{%- paginate search.results by 24 -%}
<div class="section">
  <div class="page-width">
    <div class="page-hero reveal" style="margin-bottom:clamp(2rem,4vw,3rem)">
      <h1 class="h1">{{ 'general.search.search' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="form-inline" style="max-width:34rem">
        <input class="input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
        <button type="submit" class="btn">{{ 'general.search.search' | t }}</button>
      </form>
      {%- if search.performed -%}
        <p class="muted small">{{ 'general.search.results_count' | t: count: search.results_count }}</p>
      {%- endif -%}
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <div class="product-grid" style="--cols:4;--cols-tablet:3;">
          {%- for item in search.results -%}
            {%- case item.object_type -%}
              {%- when 'product' -%}{% render 'product-card', product: item %}
              {%- when 'article' -%}{% render 'article-card', article: item %}
              {%- when 'page' -%}
                <a class="article-card" href="{{ item.url }}">
                  <p class="article-card__meta">Seite</p>
                  <h3 class="article-card__title">{{ item.title }}</h3>
                </a>
            {%- endcase -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
      {%- else -%}
        <div class="empty-state">
          <p class="h3">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
          <a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{ "name": "Suche" }
{% endschema %}
