<footer class="footer">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__logo" href="{{ routes.root_url }}" style="--logo-width:{{ settings.logo_width }}px;">
          {%- if settings.logo_inverted != blank -%}
            <img src="{{ settings.logo_inverted | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="200" height="60" loading="lazy">
          {%- elsif settings.logo != blank -%}
            <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="200" height="60" loading="lazy">
          {%- else -%}
            <span class="header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>

        {%- if section.settings.brand_text != blank -%}
          <p class="small muted">{{ section.settings.brand_text }}</p>
        {%- endif -%}

        {%- if section.settings.show_newsletter -%}
          <div style="margin-top:.5rem">
            <p class="eyebrow" style="margin-bottom:.6rem">{{ section.settings.newsletter_heading }}</p>
            {% form 'customer', class: 'form-inline' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="visually-hidden" for="FooterNewsletter">{{ 'general.newsletter_form.email_placeholder' | t }}</label>
              <input
                id="FooterNewsletter"
                class="input"
                type="email"
                name="contact[email]"
                placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
                autocomplete="email"
                required
              >
              <button type="submit" class="btn">{{ 'general.newsletter_form.button_label' | t }}</button>
              {%- if form.errors -%}
                <p class="form__message form__message--error">{{ form.errors.messages.form }}</p>
              {%- elsif form.posted_successfully? -%}
                <p class="form__message form__message--success">{{ 'general.newsletter_form.success' | t }}</p>
              {%- endif -%}
            {% endform %}
            {%- if section.settings.newsletter_legal != blank -%}
              <p class="newsletter__legal" style="margin-top:.6rem">{{ section.settings.newsletter_legal }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {% render 'social-links' %}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <p class="footer__col-title">{{ block.settings.heading }}</p>
              <ul class="footer__links">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'contact' -%}
            <div {{ block.shopify_attributes }}>
              <p class="footer__col-title">{{ block.settings.heading }}</p>
              <div class="footer__links">
                {%- if block.settings.text != blank -%}
                  <div class="rte small">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.email != blank -%}
                  <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  <a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a>
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div class="footer__legal">
        <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
        {%- if section.settings.legal_menu != blank -%}
          {%- for link in section.settings.legal_menu.links -%}
            <a href="{{ link.url }}" class="link-underline">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payments">
          <span class="visually-hidden">{{ 'sections.footer.payment_methods' | t }}</span>
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section--footer",
  "max_blocks": 4,
  "settings": [
    { "type": "textarea", "id": "brand_text", "label": "Kurztext", "default": "skinbabe baut Werkzeuge für Haarentfernung, die deine Haut in Ruhe lassen. Gegründet in Deutschland, Support auf Deutsch." },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Newsletter-Feld anzeigen", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Überschrift", "default": "Bleib in Kontakt" },
    { "type": "textarea", "id": "newsletter_legal", "label": "Rechtlicher Hinweis", "default": "Mit der Anmeldung stimmst du dem Erhalt von E-Mails zu. Abmeldung jederzeit über den Link in jeder Mail." },
    { "type": "header", "content": "Unten" },
    { "type": "link_list", "id": "legal_menu", "label": "Rechtliches-Menü" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Zahlungsarten anzeigen", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menü-Spalte",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menü" }
      ]
    },
    {
      "type": "contact",
      "name": "Kontakt-Spalte",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Kontakt" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Antwort werktags innerhalb von 24 Stunden.</p>" },
        { "type": "text", "id": "email", "label": "E-Mail" },
        { "type": "text", "id": "phone", "label": "Telefon" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Hilfe" } },
        { "type": "contact" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
