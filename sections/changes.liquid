<div class="section{% if section.settings.background == 'cream' %} surface-cream{% endif %}">
  <div class="page-width">
    <div class="section-head reveal{% if section.settings.text_align == 'center' %} section-head--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">
          {{ section.settings.heading }}
          {%- if section.settings.heading_accent != blank -%}<span class="serif">{{ section.settings.heading_accent }}</span>{%- endif -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte lede">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="changes reveal">
      {%- for block in section.blocks -%}
        <div class="change" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="change__icon">{% render 'icon', icon: block.settings.icon %}</span>
          {%- else -%}
            <span class="change__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- endif -%}
          <h3 class="change__title">{{ block.settings.title }}</h3>
          <p class="change__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Was sich ändert",
  "max_blocks": 4,
  "settings": [
    { "type": "paragraph", "content": "Vier konkrete Alltagsveränderungen — keine Feature-Liste. Kein Feature ohne Konsequenz." },
    { "type": "text", "id": "eyebrow", "label": "Kleiner Vortext", "default": "was sich ändert" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "nicht deine haut. dein kalender." },
    { "type": "text", "id": "heading_accent", "label": "Kursiver Serif-Akzent" },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "select", "id": "text_align", "label": "Ausrichtung", "default": "left",
      "options": [{ "value": "left", "label": "Links" }, { "value": "center", "label": "Zentriert" }]
    },
    {
      "type": "select", "id": "background", "label": "Hintergrund", "default": "default",
      "options": [{ "value": "default", "label": "Weiß" }, { "value": "cream", "label": "Creme" }]
    }
  ],
  "blocks": [
    {
      "type": "change",
      "name": "Veränderung",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Du planst nicht mehr vor" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Kein Rechnen mehr, ob zwei Tage reichen. Du entscheidest morgens, nicht am Dienstag davor." },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "none",
          "options": [
            { "value": "none", "label": "Nummer statt Icon" },
            { "value": "clock", "label": "Uhr" },
            { "value": "sparkle", "label": "Funkeln" },
            { "value": "droplet", "label": "Tropfen" },
            { "value": "leaf", "label": "Blatt" },
            { "value": "shield", "label": "Schild" },
            { "value": "check", "label": "Haken" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Was sich ändert",
      "blocks": [
        { "type": "change", "settings": { "title": "Du planst nicht mehr vor", "text": "Kein Rechnen mehr, ob zwei Tage reichen. Du entscheidest morgens, nicht am Dienstag davor." } },
        { "type": "change", "settings": { "title": "Der Sonntagabend gehört wieder dir", "text": "Keine Rötung, die du bis Montag früh beobachtest." } },
        { "type": "change", "settings": { "title": "Du drehst den Rückspiegel nicht mehr", "text": "Kein Check im Tageslicht, bevor du aussteigst." } },
        { "type": "change", "settings": { "title": "Die Schublade wird leerer", "text": "Kein Peeling, kein Serum, keine Creme gegen ein Problem, das gar nicht entstehen muss." } }
      ]
    }
  ]
}
{% endschema %}
