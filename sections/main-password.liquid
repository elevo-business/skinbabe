<div class="section" style="min-height:100vh;display:grid;place-items:center">
  <div class="page-width page-width--narrow center">
    <div class="stack" style="gap:1.5rem;align-items:center">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="160" height="48" style="width:160px">
      {%- else -%}
        <span class="header__logo-text" style="font-size:2rem">{{ shop.name }}</span>
      {%- endif -%}

      <h1 class="h2">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="rte lede">{{ section.settings.text }}</div>{%- endif -%}

      {% form 'customer', class: 'form-inline', style: 'justify-content:center;max-width:26rem;margin-inline:auto' %}
        <input type="hidden" name="contact[tags]" value="newsletter,password-page">
        <label class="visually-hidden" for="PasswordEmail">{{ 'general.newsletter_form.email_placeholder' | t }}</label>
        <input id="PasswordEmail" class="input" type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" required>
        <button type="submit" class="btn">{{ 'general.newsletter_form.button_label' | t }}</button>
        {%- if form.posted_successfully? -%}
          <p class="form__message form__message--success">{{ 'general.newsletter_form.success' | t }}</p>
        {%- endif -%}
      {% endform %}

      <p style="margin-top:1rem">{{ powered_by_link }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Passwortseite",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "wir sind gleich da" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Trag dich ein, dann sagen wir dir Bescheid, wenn der Shop öffnet.</p>" }
  ]
}
{% endschema %}
