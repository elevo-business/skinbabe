{%- liquid
  assign items = section.blocks | where: 'type', 'item'
-%}
<div class="announcement" style="--announcement-bg:{{ section.settings.bg }};--announcement-fg:{{ section.settings.fg }};">
  <div class="announcement__inner">
    {%- if items.size > 0 -%}
      {%- comment -%} Desktop: alle Infos nebeneinander {%- endcomment -%}
      <div class="announcement__row hide-mobile" style="display:flex;align-items:center;gap:1.5rem;">
        {%- for block in items -%}
          <span class="announcement__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}{% render 'icon', icon: block.settings.icon %}{%- endif -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="link-underline">{{ block.settings.text }}</a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </span>
          {%- unless forloop.last -%}<span class="announcement__sep" aria-hidden="true">·</span>{%- endunless -%}
        {%- endfor -%}
      </div>

      {%- comment -%} Mobil: rotierend, ohne Countdown {%- endcomment -%}
      <div class="announcement__rotator hide-desktop" style="--rotate-duration:{{ items.size | times: 5 }}s;">
        {%- for block in items -%}
          <span class="announcement__item" style="animation-delay:{{ forloop.index0 | times: 5 }}s;">
            {%- if block.settings.icon != 'none' -%}{% render 'icon', icon: block.settings.icon %}{%- endif -%}
            {{ block.settings.text }}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Ankündigungsleiste",
  "class": "shopify-section--announcement",
  "max_blocks": 4,
  "settings": [
    { "type": "paragraph", "content": "Sachliche Informationen — Versandschwelle, Lieferzeit, Rückgabefrist. Bewusst kein Dauer-Sale und kein Countdown." },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#16130F" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Information",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Versandkostenfrei ab 50 €" },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "truck",
          "options": [
            { "value": "none", "label": "Kein Icon" },
            { "value": "truck", "label": "Versand" },
            { "value": "return", "label": "Rückgabe" },
            { "value": "shield", "label": "Garantie" },
            { "value": "clock", "label": "Lieferzeit" },
            { "value": "card", "label": "Zahlung" },
            { "value": "chat", "label": "Support" }
          ]
        },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ankündigungsleiste",
      "blocks": [
        { "type": "item", "settings": { "text": "Versandkostenfrei ab 50 €", "icon": "truck" } },
        { "type": "item", "settings": { "text": "Lieferung in 2–4 Werktagen", "icon": "clock" } },
        { "type": "item", "settings": { "text": "30 Tage Rückgaberecht", "icon": "return" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
