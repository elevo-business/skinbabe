<div class="section{% if section.settings.background == 'cream' %} surface-cream{% endif %}">
  <div class="page-width">
    <div class="section-head section-head--split reveal">
      <div class="stack" style="gap:.6rem">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">
            {{ section.settings.heading }}
            {%- if section.settings.heading_accent != blank -%}<span class="serif">{{ section.settings.heading_accent }}</span>{%- endif -%}
          </h2>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="link-arrow" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">
          {{ section.settings.link_label }}
          {% render 'icon', icon: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    <div class="product-grid" style="--cols:{{ section.blocks.size | at_most: 3 }};--cols-tablet:{{ section.blocks.size | at_most: 3 }};">
      {%- for block in section.blocks -%}
        <div class="reveal" style="--reveal-delay:{{ forloop.index0 | times: 90 }}ms" {{ block.shopify_attributes }}>
          {% render 'product-card', product: block.settings.product, card_subtitle: block.settings.subtitle %}
        </div>
      {%- else -%}
        {%- for i in (1..3) -%}
          <div>{% render 'product-card' %}</div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="small muted center" style="margin-top:2rem">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Bestseller-Zeile",
  "max_blocks": 3,
  "settings": [
    { "type": "paragraph", "content": "Maximal drei Produkte. Jede Karte bekommt eine Zeile Untertitel, die den Nutzen benennt — nicht die Kategorie." },
    { "type": "text", "id": "eyebrow", "label": "Kleiner Vortext", "default": "die leiter" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "drei wege, dasselbe problem zu lösen" },
    { "type": "text", "id": "heading_accent", "label": "Kursiver Serif-Akzent" },
    { "type": "text", "id": "link_label", "label": "Link-Text", "default": "alle produkte" },
    { "type": "url", "id": "link_url", "label": "Link-Ziel" },
    { "type": "text", "id": "footnote", "label": "Fußnote", "default": "Rasierer für jetzt sofort glatt. IPL für langfristig weniger. Beides zusammen ist kein Doppelkauf." },
    {
      "type": "select", "id": "background", "label": "Hintergrund", "default": "default",
      "options": [{ "value": "default", "label": "Weiß" }, { "value": "cream", "label": "Creme" }]
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produkt",
      "settings": [
        { "type": "product", "id": "product", "label": "Produkt" },
        { "type": "text", "id": "subtitle", "label": "Untertitel (Nutzen, nicht Kategorie)", "info": "Wird auch aus dem Metafeld skinbabe.card_subtitle gezogen, falls gepflegt." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bestseller-Zeile",
      "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }]
    }
  ]
}
{% endschema %}
