{%- comment -%}
  Lieferumfang / Im Set enthalten. Zeigt jede Komponente mit Bild, Titel und
  Beschreibung. Der optionale FREE-Badge macht den Wert der Zugaben sichtbar,
  ohne einen erfundenen Preis zu behaupten.
{%- endcomment -%}
<div class="section{% if section.settings.background == 'cream' %} surface-cream{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-head reveal{% if section.settings.text_align == 'center' %} section-head--center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">
            {{ section.settings.heading }}
            {%- if section.settings.heading_accent != blank -%}<span class="serif">{{ section.settings.heading_accent }}</span>{%- endif -%}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte lede">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="included reveal" style="--included-cols:{{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <div class="included-card{% if block.settings.free %} included-card--free{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.free -%}
            <span class="included-card__badge">{{ section.settings.free_label }}</span>
          {%- elsif block.settings.badge != blank -%}
            <span class="included-card__badge included-card__badge--neutral">{{ block.settings.badge }}</span>
          {%- endif -%}

          <div class="included-card__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 400 }}"
                srcset="{{ block.settings.image | image_url: width: 200 }} 200w, {{ block.settings.image | image_url: width: 400 }} 400w"
                sizes="(min-width: 990px) 12vw, 30vw"
                alt="{{ block.settings.image.alt | escape | default: block.settings.title }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          <div class="included-card__body">
            <h3 class="included-card__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="included-card__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="included-foot reveal">
        {%- if section.settings.value_note != blank -%}
          <p class="included-value">{{ section.settings.value_note }}</p>
        {%- endif -%}
        <a class="btn btn--lg" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
          {% render 'icon', icon: 'arrow' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Lieferumfang",
  "settings": [
    { "type": "paragraph", "content": "Zeigt, was im Set steckt. Der FREE-Badge macht den Wert der Zugaben sichtbar. Ein erfundener Streichpreis auf Zugaben schwächt das Angebot — jede Kundin weiß ungefähr, was eine Reinigungsbürste kostet." },
    { "type": "text", "id": "eyebrow", "label": "Kleiner Vortext", "default": "im set enthalten" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "alles, was du für den perfekten shave brauchst" },
    { "type": "text", "id": "heading_accent", "label": "Kursiver Serif-Akzent" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Spalten (Desktop)", "default": 4 },
    {
      "type": "select", "id": "text_align", "label": "Ausrichtung der Überschrift", "default": "center",
      "options": [{ "value": "left", "label": "Links" }, { "value": "center", "label": "Zentriert" }]
    },
    { "type": "text", "id": "free_label", "label": "Text des Gratis-Badges", "default": "GRATIS" },
    { "type": "header", "content": "Abschluss" },
    { "type": "text", "id": "value_note", "label": "Wert-Hinweis", "info": "z. B. „Zubehör im Wert von 39 €, gratis dazu.“ Nur mit echtem Wert." },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    {
      "type": "select", "id": "background", "label": "Hintergrund", "default": "cream",
      "options": [{ "value": "default", "label": "Weiß" }, { "value": "cream", "label": "Creme" }]
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Komponente",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "title", "label": "Titel", "default": "SilkGlide Pro 2.0™" },
        { "type": "textarea", "id": "text", "label": "Beschreibung", "default": "Deine All-in-one-Lösung. Gleitet mühelos über jede Kurve, wasserdicht für Dusche und Trockenrasur." },
        { "type": "checkbox", "id": "free", "label": "Als GRATIS markieren", "default": false },
        { "type": "text", "id": "badge", "label": "Anderer Badge", "info": "Nur ohne Gratis-Markierung. z. B. „Neu“." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lieferumfang",
      "blocks": [
        { "type": "item", "settings": { "title": "SilkGlide Pro 2.0™", "text": "Deine All-in-one-Lösung. Gleitet mühelos über jede Kurve, wasserdicht für Dusche und Trockenrasur." } },
        { "type": "item", "settings": { "title": "BodySmooth™ Scherkopf", "text": "Für sanfte Präzision ohne Nicks. Bleibt bis zu 50 Rasuren scharf." } },
        { "type": "item", "settings": { "title": "USB-Ladekabel", "text": "Damit dein Gerät immer einsatzbereit ist." } },
        { "type": "item", "settings": { "free": true, "title": "Runder Intimaufsatz", "text": "Für Bikinizone, Achseln und Gesicht. Runde Klingen berühren die Haut nie direkt." } },
        { "type": "item", "settings": { "free": true, "title": "Schutzkappe", "text": "Schützt empfindliche Haut und reduziert Reizungen im Alltag." } },
        { "type": "item", "settings": { "free": true, "title": "Peeling-Handschuh", "text": "Entfernt sanft abgestorbene Haut und beugt eingewachsenen Haaren vor." } },
        { "type": "item", "settings": { "free": true, "title": "Reinigungsbürste", "text": "Fegt Haare und Rückstände weg, bevor du den Scherkopf abspülst." } }
      ]
    }
  ]
}
{% endschema %}
