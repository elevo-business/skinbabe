{%- liquid
  assign menu = section.settings.menu

  comment
    Zwei getrennte Dinge:
    - transparent: der Header hat keinen eigenen Hintergrund
    - overlap:     er legt sich zusaetzlich ueber den ersten Abschnitt

    Ueberlagern ergibt nur Sinn, wo darunter ein Bild liegt. Auf einer
    Produktseite wuerde sonst der Inhalt unter den Header rutschen.
  endcomment
  assign transparent = false
  if section.settings.transparent_mode == 'all'
    assign transparent = true
  elsif section.settings.transparent_mode == 'index' and template.name == 'index'
    assign transparent = true
  endif

  assign overlap = false
  if section.settings.overlap_mode == 'all'
    assign overlap = true
  elsif section.settings.overlap_mode == 'index' and template.name == 'index'
    assign overlap = true
  endif

  comment
    Schriftfarbe: automatisch heisst hell, wo der Header ueber einem Bild
    liegt, sonst dunkel. So bleibt das Logo ueberall sichtbar.
  endcomment
  assign text_scheme = section.settings.transparent_text
  if text_scheme == 'auto'
    if overlap
      assign text_scheme = 'light'
    else
      assign text_scheme = 'dark'
    endif
  endif
-%}
<sb-header
  class="
    {%- if transparent %} header--transparent header--transparent-{{ text_scheme }}{% endif -%}
    {%- if overlap %} header--overlap{% endif -%}
    {%- if transparent and text_scheme == 'light' and settings.logo_inverted == blank %} header--logo-auto-invert{% endif -%}
    {%- if section.settings.logo_grows_header %} header--logo-leads{% endif -%}
  "
  data-hide-on-scroll="{{ section.settings.hide_on_scroll }}"
  data-transparent="{{ transparent }}"
  style="
    --header-height:{{ section.settings.height_mobile }}px;
    --header-height-desktop:{{ section.settings.height }}px;
    --logo-width:{{ settings.logo_width }}px;
    --logo-height:{{ section.settings.logo_height_mobile }}px;
    --logo-height-desktop:{{ section.settings.logo_height }}px;
  "
>
  <div class="header">
    <button
      class="header__icon header__menu-toggle"
      type="button"
      data-drawer-open="NavDrawer"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      {% render 'icon', icon: 'menu' %}
    </button>

    <nav class="header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="nav">
        {%- for link in menu.links -%}
          {%- assign mega_block = null -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'mega' and block.settings.trigger == link.title -%}
              {%- assign mega_block = block -%}
            {%- endif -%}
          {%- endfor -%}

          <li class="nav__item"{% if link.links.size > 0 or mega_block %} data-mega{% endif %}>
            {%- if link.links.size > 0 or mega_block -%}
              <a
                href="{{ link.url }}"
                class="nav__link{% if link.title contains '*' %} nav__link--highlight{% endif %}"
                data-mega-trigger
                aria-expanded="false"
              >
                {{ link.title | remove: '*' }}
                {% render 'icon', icon: 'chevron' %}
              </a>

              <div class="mega">
                <div class="mega__grid">
                  {%- if mega_block -%}
                    {%- for i in (1..3) -%}
                      {%- liquid
                        assign title_key = 'col_' | append: i | append: '_title'
                        assign menu_key = 'col_' | append: i | append: '_menu'
                        assign col_title = mega_block.settings[title_key]
                        assign col_menu = mega_block.settings[menu_key]
                      -%}
                      {%- if col_menu != blank -%}
                        <div>
                          {%- if col_title != blank -%}<p class="mega__col-title">{{ col_title }}</p>{%- endif -%}
                          <ul class="mega__links">
                            {%- for child in col_menu.links -%}
                              <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}

                    {%- if mega_block.settings.feature_image != blank or mega_block.settings.feature_title != blank -%}
                      <a class="mega__feature" href="{{ mega_block.settings.feature_link }}">
                        {%- if mega_block.settings.feature_image -%}
                          <div class="media media--landscape">
                            <img src="{{ mega_block.settings.feature_image | image_url: width: 600 }}" alt="{{ mega_block.settings.feature_image.alt | escape }}" loading="lazy" width="600" height="400">
                          </div>
                        {%- endif -%}
                        {%- if mega_block.settings.feature_title != blank -%}
                          <span class="link-arrow">{{ mega_block.settings.feature_title }} {% render 'icon', icon: 'arrow' %}</span>
                        {%- endif -%}
                      </a>
                    {%- endif -%}
                  {%- else -%}
                    {%- for child in link.links -%}
                      <div>
                        <p class="mega__col-title">{{ child.title }}</p>
                        <ul class="mega__links">
                          {%- if child.links.size > 0 -%}
                            {%- for grandchild in child.links -%}
                              <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                            {%- endfor -%}
                          {%- else -%}
                            <li><a href="{{ child.url }}">{{ 'general.continue_shopping' | t }}</a></li>
                          {%- endif -%}
                        </ul>
                      </div>
                    {%- endfor -%}
                  {%- endif -%}
                </div>
              </div>
            {%- else -%}
              <a href="{{ link.url }}" class="nav__link{% if link.title contains '*' %} nav__link--highlight{% endif %}">{{ link.title | remove: '*' }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <a class="header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        <img
          class="header__logo-img header__logo-img--default"
          src="{{ settings.logo | image_url: width: 600 }}"
          alt="{{ shop.name | escape }}"
          width="{{ settings.logo.width }}"
          height="{{ settings.logo.height }}"
          {% if template.name == 'index' %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
        >
        {%- if transparent and text_scheme == 'light' and settings.logo_inverted != blank -%}
          <img
            class="header__logo-img header__logo-img--inverted"
            src="{{ settings.logo_inverted | image_url: width: 600 }}"
            alt=""
            aria-hidden="true"
            width="{{ settings.logo_inverted.width }}"
            height="{{ settings.logo_inverted.height }}"
            {% if template.name == 'index' %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
          >
        {%- endif -%}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="header__actions">
      <button class="header__icon" type="button" data-drawer-open="SearchDrawer" aria-label="{{ 'general.search.search' | t }}">
        {% render 'icon', icon: 'search' %}
      </button>

      {%- if shop.customer_accounts_enabled -%}
        <a class="header__icon hide-mobile" href="{{ routes.account_url }}" aria-label="{{ 'sections.header.account' | t }}">
          {% render 'icon', icon: 'account' %}
        </a>
      {%- endif -%}

      {%- if settings.cart_type == 'drawer' -%}
        <button class="header__icon" type="button" data-drawer-open="CartDrawer" aria-label="{{ 'sections.header.cart' | t }}">
          {% render 'icon', icon: 'cart' %}
          {% render 'cart-count' %}
        </button>
      {%- else -%}
        <a class="header__icon" href="{{ routes.cart_url }}" aria-label="{{ 'sections.header.cart' | t }}">
          {% render 'icon', icon: 'cart' %}
          {% render 'cart-count' %}
        </a>
      {%- endif -%}
    </div>
  </div>
</sb-header>

{% render 'header-drawer', menu: menu, section: section %}
{% render 'search-drawer' %}

{%- if section.settings.enable_structured_data -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
      {%- if settings.logo %},
      "logo": {{ settings.logo | image_url: width: 500 | prepend: 'https:' | json }}
      {%- endif -%}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "shopify-section--header",
  "max_blocks": 4,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Hauptmenü",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "paragraph",
      "content": "Die Logo-Höhe ist der eigentliche Regler. Die Breite unter Marke wirkt nur als Obergrenze — ist sie zu klein, bleibt das Logo klein."
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 16,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Logo-Höhe (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 14,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Logo-Höhe (Mobil)",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "logo_grows_header",
      "label": "Kopfhöhe an das Logo anpassen",
      "default": false,
      "info": "Aus: Die Kopfhöhe bleibt fest, ein großes Logo ragt darüber hinaus. An: Der Header wächst mit dem Logo mit."
    },
    {
      "type": "header",
      "content": "Kopfhöhe"
    },
    {
      "type": "range",
      "id": "height",
      "min": 48,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Kopfhöhe (Desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 44,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Kopfhöhe (Mobil)",
      "default": 54
    },
    {
      "type": "header",
      "content": "Transparenz"
    },
    {
      "type": "select",
      "id": "transparent_mode",
      "label": "Transparenter Hintergrund",
      "default": "all",
      "options": [
        {
          "value": "off",
          "label": "Aus"
        },
        {
          "value": "index",
          "label": "Nur auf der Startseite"
        },
        {
          "value": "all",
          "label": "Im ganzen Store"
        }
      ]
    },
    {
      "type": "select",
      "id": "overlap_mode",
      "label": "Über den Inhalt legen",
      "default": "index",
      "options": [
        {
          "value": "off",
          "label": "Aus"
        },
        {
          "value": "index",
          "label": "Nur auf der Startseite"
        },
        {
          "value": "all",
          "label": "Auf allen Seiten"
        }
      ],
      "info": "Nur dort einschalten, wo der erste Abschnitt ein Bild ist. Sonst rutscht der Inhalt unter den Header."
    },
    {
      "type": "select",
      "id": "transparent_text",
      "label": "Schriftfarbe",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatisch (hell über Bildern, sonst dunkel)"
        },
        {
          "value": "light",
          "label": "Immer hell"
        },
        {
          "value": "dark",
          "label": "Immer dunkel"
        }
      ]
    },
    {
      "type": "header",
      "content": "Verhalten"
    },
    {
      "type": "checkbox",
      "id": "hide_on_scroll",
      "label": "Header beim Runterscrollen ausblenden",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_structured_data",
      "label": "Organization-Markup ausgeben",
      "default": true
    },
    {
      "type": "header",
      "content": "Drawer-Menü"
    },
    {
      "type": "text",
      "id": "drawer_note",
      "label": "Hinweis unten im Menü",
      "default": "Fragen? Wir antworten werktags innerhalb von 24 Stunden."
    },
    {
      "type": "url",
      "id": "drawer_note_link",
      "label": "Link zum Hinweis"
    }
  ],
  "blocks": [
    {
      "type": "mega",
      "name": "Mega-Menü",
      "settings": [
        {
          "type": "text",
          "id": "trigger",
          "label": "Menüpunkt (exakter Titel)",
          "info": "Muss genau dem Titel im Hauptmenü entsprechen."
        },
        {
          "type": "text",
          "id": "col_1_title",
          "label": "Spalte 1 – Überschrift"
        },
        {
          "type": "link_list",
          "id": "col_1_menu",
          "label": "Spalte 1 – Menü"
        },
        {
          "type": "text",
          "id": "col_2_title",
          "label": "Spalte 2 – Überschrift"
        },
        {
          "type": "link_list",
          "id": "col_2_menu",
          "label": "Spalte 2 – Menü"
        },
        {
          "type": "text",
          "id": "col_3_title",
          "label": "Spalte 3 – Überschrift"
        },
        {
          "type": "link_list",
          "id": "col_3_menu",
          "label": "Spalte 3 – Menü"
        },
        {
          "type": "header",
          "content": "Teaser"
        },
        {
          "type": "image_picker",
          "id": "feature_image",
          "label": "Bild"
        },
        {
          "type": "text",
          "id": "feature_title",
          "label": "Teaser-Text"
        },
        {
          "type": "url",
          "id": "feature_link",
          "label": "Teaser-Link"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
