<div class="section{% if section.settings.background == 'cream' %} surface-cream{% endif %}">
  <div class="page-width{% if section.settings.width == 'narrow' %} page-width--narrow{% endif %}">
    <div class="section-head reveal{% if section.settings.text_align == 'center' %} section-head--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">
          {{ section.settings.heading }}
          {%- if section.settings.heading_accent != blank -%}<span class="serif">{{ section.settings.heading_accent }}</span>{%- endif -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte lede">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <sb-compare class="reveal">
      {%- if section.settings.image_before != blank -%}
        <img
          src="{{ section.settings.image_before | image_url: width: 1400 }}"
          srcset="{{ section.settings.image_before | image_url: width: 700 }} 700w, {{ section.settings.image_before | image_url: width: 1400 }} 1400w"
          sizes="(min-width: 990px) 60vw, 100vw"
          alt="{{ section.settings.label_before | escape }}"
          width="{{ section.settings.image_before.width }}"
          height="{{ section.settings.image_before.height }}"
          loading="lazy"
        >
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}

      <div class="compare__after">
        {%- if section.settings.image_after != blank -%}
          <img
            src="{{ section.settings.image_after | image_url: width: 1400 }}"
            alt="{{ section.settings.label_after | escape }}"
            width="{{ section.settings.image_after.width }}"
            height="{{ section.settings.image_after.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <span class="compare__handle" aria-hidden="true"></span>
      <span class="compare__grip" aria-hidden="true">{% render 'icon', icon: 'arrow' %}</span>

      {%- if section.settings.label_before != blank -%}
        <span class="compare__label compare__label--before">{{ section.settings.label_before }}</span>
      {%- endif -%}
      {%- if section.settings.label_after != blank -%}
        <span class="compare__label compare__label--after">{{ section.settings.label_after }}</span>
      {%- endif -%}

      <label class="visually-hidden" for="Compare-{{ section.id }}">{{ section.settings.slider_label }}</label>
      <input class="compare__range" type="range" id="Compare-{{ section.id }}" min="0" max="100" value="50" step="1">
    </sb-compare>

    {%- if section.settings.disclaimer != blank -%}
      <p class="small muted" style="margin-top:1.25rem">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Vorher / Nachher",
  "settings": [
    { "type": "paragraph", "content": "Nur echte, unretuschierte Aufnahmen verwenden. Der Hinweis unten sollte benennen, unter welchen Bedingungen die Bilder entstanden sind." },
    { "type": "text", "id": "eyebrow", "label": "Kleiner Vortext", "default": "der unterschied" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "zieh den regler" },
    { "type": "text", "id": "heading_accent", "label": "Kursiver Serif-Akzent" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image_before", "label": "Bild vorher" },
    { "type": "image_picker", "id": "image_after", "label": "Bild nachher" },
    { "type": "text", "id": "label_before", "label": "Beschriftung vorher", "default": "vorher" },
    { "type": "text", "id": "label_after", "label": "Beschriftung nachher", "default": "nachher" },
    { "type": "text", "id": "slider_label", "label": "Bezeichnung des Reglers (Screenreader)", "default": "Vergleich zwischen vorher und nachher" },
    { "type": "textarea", "id": "disclaimer", "label": "Hinweis", "default": "Aufnahmen einer Kundin, unretuschiert. Ergebnisse fallen individuell unterschiedlich aus." },
    {
      "type": "select", "id": "width", "label": "Breite", "default": "narrow",
      "options": [{ "value": "narrow", "label": "Schmal" }, { "value": "wide", "label": "Breit" }]
    },
    {
      "type": "select", "id": "text_align", "label": "Ausrichtung", "default": "center",
      "options": [{ "value": "left", "label": "Links" }, { "value": "center", "label": "Zentriert" }]
    },
    {
      "type": "select", "id": "background", "label": "Hintergrund", "default": "cream",
      "options": [{ "value": "default", "label": "Weiß" }, { "value": "cream", "label": "Creme" }]
    }
  ],
  "presets": [{ "name": "Vorher / Nachher" }]
}
{% endschema %}
