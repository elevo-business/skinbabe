<div class="section">
  <div class="page-width page-width--narrow" style="max-width:26rem">
    <h1 class="h2" style="margin-bottom:1.5rem">{{ 'customer.reset_password.title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'stack', style: 'gap:1rem' -%}
      {%- if form.errors -%}<p class="form__message form__message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field">
        <label class="field__label" for="ResetPw">{{ 'customer.reset_password.password' | t }}</label>
        <input type="password" id="ResetPw" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ResetPwConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input type="password" id="ResetPwConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--full">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
