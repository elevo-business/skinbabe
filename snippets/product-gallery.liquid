{%- liquid
  assign layout = layout | default: 'carousel'
  assign ratio_setting = section.settings.gallery_ratio | default: 'adapt'
  assign fit = section.settings.gallery_fit | default: 'contain'

  case ratio_setting
    when 'square'
      assign ratio = 1.0
    when 'portrait'
      assign ratio = 0.8
    when 'tall'
      assign ratio = 0.7143
    when 'landscape'
      assign ratio = 1.5
    else
      comment
        „Wie das Bild“: Seitenverhaeltnis des Hauptbilds, aber fuer alle Slides
        gleich — sonst springt die Hoehe beim Wischen.
      endcomment
      assign ratio = product.featured_media.aspect_ratio
  endcase

  if ratio == blank or ratio == 0
    assign ratio = 1.0
  endif
-%}
<sb-media-gallery
  class="product__gallery{% if layout == 'stacked' %} product__gallery--stacked{% endif %}"
  id="gallery-{{ section.id }}"
  style="--gallery-ratio:{{ ratio }};--gallery-fit:{{ fit }};"
>
  <div class="gallery__viewer" data-gallery-viewer>
    {%- if product.media.size > 0 -%}
      {%- for media in product.media -%}
        <div class="gallery__slide" data-media-id="{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              <img
                src="{{ media | image_url: width: 1200 }}"
                srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1400 }} 1400w"
                sizes="(min-width: 990px) 50vw, 100vw"
                alt="{{ media.alt | escape }}"
                width="{{ media.width }}"
                height="{{ media.height }}"
                {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
              >
            {%- when 'video' -%}
              {{ media | video_tag: image_size: '1200x', controls: true, muted: true }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag }}
            {%- when 'model' -%}
              {{ media | model_viewer_tag }}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
    {%- endif -%}
  </div>

  {%- if product.media.size > 1 -%}
    <div class="gallery__counter hide-desktop" aria-hidden="true">
      <span data-gallery-current>1</span> / {{ product.media.size }}
    </div>

    <div class="gallery__thumbs">
      {%- for media in product.media -%}
        <button
          type="button"
          class="gallery__thumb"
          data-gallery-thumb
          data-media-target="{{ media.id }}"
          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="{{ 'general.accessibility.next_slide' | t }} {{ forloop.index }}"
        >
          <img src="{{ media.preview_image | image_url: width: 200 }}" alt="" width="100" height="100" loading="lazy">
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</sb-media-gallery>
