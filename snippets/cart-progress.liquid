{%- liquid
  assign threshold = settings.cart_free_shipping_threshold | plus: 0
-%}
{%- if threshold > 0 -%}
  <sb-cart-progress
    class="cart-progress{% if cart.total_price >= threshold %} is-complete{% endif %}"
    data-threshold="{{ threshold }}"
    data-total="{{ cart.total_price }}"
    data-remaining="{{ 'cart.general.free_shipping_progress' | t: amount: '%%' }}"
    data-reached="{{ 'cart.general.free_shipping_reached' | t }}"
  >
    <p class="cart-progress__text" data-progress-text>
      {%- if cart.total_price >= threshold -%}
        {{ 'cart.general.free_shipping_reached' | t }}
      {%- else -%}
        {%- assign remaining = threshold | minus: cart.total_price | money -%}
        {{ 'cart.general.free_shipping_progress' | t: amount: remaining }}
      {%- endif -%}
    </p>
    <span class="cart-progress__track">
      <span class="cart-progress__bar" data-progress-bar style="--progress:{% if cart.total_price >= threshold %}100{% else %}{{ cart.total_price | times: 100 | divided_by: threshold }}{% endif %}%"></span>
    </span>
  </sb-cart-progress>
{%- endif -%}
