{%- liquid
  assign form_id = 'product-form-' | append: section.id
  assign price_id = 'sticky-price-' | append: section.id
-%}
<sb-sticky-buy data-anchor="buy-anchor-{{ section.id }}" data-section="{{ section.id }}">
  <div class="sticky-buy">
    {%- if product.featured_media -%}
      <span class="sticky-buy__media">
        <img src="{{ product.featured_media | image_url: width: 120 }}" alt="" width="60" height="60" loading="lazy">
      </span>
    {%- endif -%}

    <span class="sticky-buy__info">
      <span class="sticky-buy__title">{{ product.title }}</span>
      <span class="sticky-buy__price" data-sticky-price>
        {% render 'price', product: product, id: price_id %}
      </span>
    </span>

    <button
      type="submit"
      form="{{ form_id }}"
      class="btn"
      {% unless product.available %}disabled aria-disabled="true"{% endunless %}
    >
      <span data-btn-label>
        {%- if product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
      </span>
    </button>
  </div>
</sb-sticky-buy>
