{%- liquid
  assign qty_id = id | default: 'Quantity'
  assign qty_value = value | default: 1
  assign qty_min = min | default: 1
-%}
<sb-quantity class="qty">
  <button type="button" data-qty="minus" aria-label="{{ 'products.product.decrease_quantity' | t }}">{% render 'icon', icon: 'minus' %}</button>
  <input
    class="qty__input"
    type="number"
    id="{{ qty_id }}"
    name="{{ name | default: 'quantity' }}"
    value="{{ qty_value }}"
    min="{{ qty_min }}"
    step="1"
    inputmode="numeric"
    aria-label="{{ 'products.product.quantity' | t }}"
    {% if line %}data-cart-qty data-line="{{ line }}"{% endif %}
  >
  <button type="button" data-qty="plus" aria-label="{{ 'products.product.increase_quantity' | t }}">{% render 'icon', icon: 'plus' %}</button>
</sb-quantity>
