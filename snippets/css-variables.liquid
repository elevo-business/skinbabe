{%- liquid
  assign accent = settings.color_accent
  assign accent_contrast = '#ffffff'
  assign brightness = accent | color_brightness
  if brightness > 160
    assign accent_contrast = settings.color_ink
  endif

  comment
    Font-Stacks werden defensiv gebaut: fehlt ein Font-Drop (z. B. weil eine
    Einstellung noch nicht gesetzt ist), greift ein vernuenftiger Fallback
    statt der Browser-Standardschrift.
  endcomment

  assign sans_fallback = "'Helvetica Neue', Helvetica, Arial, sans-serif"
  assign serif_fallback = "Georgia, 'Times New Roman', serif"

  assign body_family = sans_fallback
  if settings.type_body_font.family != blank
    assign body_family = settings.type_body_font.family | append: ', ' | append: settings.type_body_font.fallback_families | append: ', ' | append: sans_fallback
  endif

  assign heading_family = body_family
  if settings.type_heading_font.family != blank
    assign heading_family = settings.type_heading_font.family | append: ', ' | append: settings.type_heading_font.fallback_families | append: ', ' | append: sans_fallback
  endif

  assign accent_family = serif_fallback
  if settings.type_accent_font.family != blank
    assign accent_family = settings.type_accent_font.family | append: ', ' | append: settings.type_accent_font.fallback_families | append: ', ' | append: serif_fallback
  endif

  if settings.custom_font_name != blank and settings.custom_font_woff2 != blank
    assign custom_stack = "'" | append: settings.custom_font_name | append: "', " | append: heading_family
    if settings.custom_font_role == 'heading' or settings.custom_font_role == 'both'
      assign heading_family = custom_stack
    endif
    if settings.custom_font_role == 'body' or settings.custom_font_role == 'both'
      assign body_family = "'" | append: settings.custom_font_name | append: "', " | append: body_family
    endif
  endif

  assign body_weight = settings.type_body_font.weight | default: 400
  assign heading_weight = settings.type_heading_font.weight | default: 500
-%}
{% style %}
  :root{
    /* --- Palette --- */
    --sb-bg:{{ settings.color_background }};
    --sb-ink:{{ settings.color_ink }};
    --sb-muted:{{ settings.color_ink | color_mix: settings.color_background, 62 }};
    --sb-cream:{{ settings.color_cream }};
    --sb-accent:{{ accent }};
    --sb-accent-contrast:{{ accent_contrast }};
    --sb-accent-soft:{{ accent | color_mix: settings.color_background, 14 }};
    --sb-gold:{{ settings.color_gold }};
    --sb-sale:{{ settings.color_sale }};
    --sb-success:#2f7d54;
    --sb-error:#b3261e;
    --sb-line:{{ settings.color_ink | color_modify: 'alpha', 0.10 }};
    --sb-line-strong:{{ settings.color_ink | color_modify: 'alpha', 0.22 }};
    --sb-overlay:{{ settings.color_ink | color_modify: 'alpha', 0.45 }};

    /* --- Type --- */
    --sb-font-body:{{ body_family }};
    --sb-font-heading:{{ heading_family }};
    --sb-font-accent:{{ accent_family }};
    --sb-body-weight:{{ body_weight }};
    --sb-heading-weight:{{ heading_weight }};
    --sb-heading-tracking:{{ settings.type_heading_tracking | default: '-0.02' }}em;
    --sb-heading-case:{{ settings.type_heading_case | default: 'lowercase' }};
    --sb-text-base:{{ settings.type_body_size | default: 16 | divided_by: 16.0 }}rem;

    /* --- Space --- */
    --sb-page-width:{{ settings.layout_page_width | default: 1440 }}px;
    --sb-gutter:1.25rem;
    --sb-grid-gap:1.25rem;
    --sb-space-section:clamp(3rem,{{ settings.layout_section_spacing | default: 6 }}vw,{{ settings.layout_section_spacing | default: 6 | times: 1.4 }}rem);

    /* --- Shape --- */
    --sb-radius-pill:{{ settings.shape_button_radius | default: 100 }}px;
    --sb-radius-lg:{{ settings.shape_card_radius | default: 16 }}px;
    --sb-radius-md:{{ settings.shape_card_radius | default: 16 | divided_by: 2 }}px;
    --sb-btn-height:3rem;

    /* --- Motion --- */
    --sb-ease:cubic-bezier(.2,.7,.25,1);

    /* Header-Hoehe, wird per JS aktuell gehalten */
    --sb-header-height:72px;
  }
  @media screen and (min-width:750px){
    :root{--sb-gutter:2.5rem;--sb-grid-gap:2.5rem}
  }
  @media screen and (min-width:1200px){
    :root{--sb-gutter:3.5rem}
  }
{% endstyle %}
