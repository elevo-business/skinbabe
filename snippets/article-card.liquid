<article class="article-card reveal">
  <a href="{{ article.url }}" class="media media--landscape" aria-label="{{ article.title | escape }}">
    {%- if article.image -%}
      <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape }}" width="800" height="533" loading="lazy">
    {%- else -%}
      {{ 'blog-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <p class="article-card__meta">{{ article.published_at | date: '%d.%m.%Y' }}{% if article.tags.size > 0 %} · {{ article.tags.first }}{% endif %}</p>
  <h3 class="article-card__title"><a href="{{ article.url }}" class="link-underline">{{ article.title }}</a></h3>
  {%- if article.excerpt_or_content != blank -%}
    <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
  {%- endif -%}
  <a class="link-arrow" href="{{ article.url }}">{{ 'blogs.article.read_more' | t }} {% render 'icon', icon: 'arrow' %}</a>
</article>
