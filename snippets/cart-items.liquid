<sb-cart-items class="cart-items">
  {%- for item in cart.items -%}
    <div class="cart-item" data-cart-item>
      <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="100" height="125" loading="lazy">
        {%- endif -%}
      </a>
      <div>
        <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__variant">{{ item.variant.title }}</p>
        {%- endunless -%}
        {%- if item.selling_plan_allocation -%}
          <p class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-item__discount">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>
        {%- endfor -%}

        <div class="cart-item__row">
          {% render 'quantity-input', id: 'CartQty-' | append: forloop.index, value: item.quantity, line: forloop.index, min: 0 %}
          <span class="price">
            {%- if item.original_line_price != item.final_line_price -%}
              <s class="price__compare">{{ item.original_line_price | money }}</s>
              <span class="price__current">{{ item.final_line_price | money }}</span>
            {%- else -%}
              <span class="price__current">{{ item.final_line_price | money }}</span>
            {%- endif -%}
          </span>
        </div>

        <button type="button" class="cart-item__remove" data-cart-remove data-line="{{ forloop.index }}">
          {{ 'cart.general.remove' | t }}
        </button>
      </div>
    </div>
  {%- endfor -%}
</sb-cart-items>
