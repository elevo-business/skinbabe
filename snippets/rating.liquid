{%- comment -%}
  Bewertung eines Produkts. Liest ausschliesslich die Metafelder, die
  Review-Apps (Judge.me, Loox, Okendo, Shopify Product Reviews) schreiben.
  Ohne echte Bewertungen wird nichts ausgegeben — es gibt hier bewusst kein
  Feld, in das sich eine Wunschbewertung eintragen liesse.
{%- endcomment -%}
{%- liquid
  assign rating_object = product.metafields.reviews.rating.value
  assign count = product.metafields.reviews.rating_count.value | plus: 0
  assign style = style | default: 'inline'
-%}
{%- if rating_object and count > 0 -%}
  {%- liquid
    assign value = rating_object.rating
    assign scale = rating_object.scale_max | default: 5
    if scale != 5
      assign value = value | divided_by: scale | times: 5.0
    endif
  -%}

  {%- case style -%}
    {%- when 'summary' -%}
      <a class="rating rating--summary" href="#reviews">
        {% render 'stars', value: value, size: 'md' %}
        <span class="rating__value">{{ value | round: 1 }}</span>
        <span class="rating__count">{{ count }} Bewertungen</span>
      </a>

    {%- when 'compact' -%}
      <span class="rating">
        {% render 'stars', value: value %}
        <span>{{ count }}</span>
      </span>

    {%- else -%}
      <span class="rating">
        {% render 'stars', value: value %}
        <span>{{ value | round: 1 }} ({{ count }})</span>
      </span>
  {%- endcase -%}
{%- endif -%}
