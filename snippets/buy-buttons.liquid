{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
  assign qty_field_id = 'ProductQty-' | append: section.id
-%}
<sb-product-form class="product__buy" data-cart-type="{{ settings.cart_type }}">
  {%- form 'product', product, id: product_form_id, class: 'product__buy', novalidate: 'novalidate', data-product-form: 'true' -%}
    <input type="hidden" name="id" value="{{ variant.id }}">
    {%- unless show_quantity -%}
      <input type="hidden" name="quantity" value="1">
    {%- endunless -%}

    <div class="product__buy-row">
      {%- if show_quantity -%}
        {% render 'quantity-input', id: qty_field_id, value: 1, min: 1 %}
      {%- endif -%}
      <button
        type="submit"
        name="add"
        class="btn btn--lg"
        {% unless product.available %}disabled aria-disabled="true"{% endunless %}
      >
        <span data-btn-label>
          {%- if product.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </span>
      </button>
    </div>

    {%- if show_dynamic_checkout and product.available -%}
      {{ form | payment_button }}
    {%- endif -%}

    <p class="form__message form__message--error" data-form-error hidden></p>
  {%- endform -%}
</sb-product-form>
